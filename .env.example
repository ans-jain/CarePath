# ==============================================================================
# CarePath Environment Configuration Specification (.env.example)
#
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO VERSION CONTROL.
# For local development: copy this file to `.env` and fill in values.
# For CI/CD & Production: inject these variables via platform secrets (GitHub Secrets, AWS SSM, etc.).
# ==============================================================================

# ==============================================================================
# 1. Environment & Profiles
# ==============================================================================
# Active Spring Profile: 'dev', 'test', or 'prod'
SPRING_PROFILES_ACTIVE=dev

# Application HTTP Port (Default: 8080)
PORT=8080

# Production Edge HTTP/HTTPS Port for Docker Compose (Default: 80)
HTTP_PORT=80

# ==============================================================================
# 2. PostgreSQL Relational Database Configuration
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carepath
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here

# Full JDBC URL (Used when connecting to managed Cloud RDS / Supabase / Neon)
# If provided, this overrides DB_HOST/DB_PORT/DB_NAME
# Example: jdbc:postgresql://your-rds-endpoint.amazonaws.com:5432/carepath?sslmode=require
# SPRING_DATASOURCE_URL=

# HikariCP Pool Sizing
DB_POOL_MAX_SIZE=15
DB_POOL_MIN_IDLE=5

# ==============================================================================
# 3. JWT Security & Authentication Secrets
# ==============================================================================
# CRITICAL: In production, generate a secure 256-bit key using:
# openssl rand -hex 32
JWT_SECRET=your_minimum_256_bit_cryptographic_secret_key_hex_or_base64_string_here

# Access Token Validity (in milliseconds; default: 15 minutes = 900,000 ms)
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000

# Refresh Token Validity (in milliseconds; default: 7 days = 604,800,000 ms)
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# ==============================================================================
# 4. Machine Learning Microservice Configuration
# ==============================================================================
# Internal endpoint for FastAPI ML Service
# In local dev: http://localhost:8000
# In Docker Compose: http://carepath-ml-service:8000
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=2500

# ==============================================================================
# 5. Frontend & Web Client Configuration
# ==============================================================================
# Base URL for Spring Boot backend as accessed by browser (or via reverse proxy)
# In production with reverse proxy, leave empty or set to /api/v1
VITE_BACKEND_URL=http://localhost:8080/api/v1

# Base URL for ML service as accessed by browser (or via reverse proxy)
# In production with reverse proxy, leave empty or set to ''
VITE_ML_URL=http://localhost:8000

# ==============================================================================
# 6. Security Hardening, CORS & Rate Limiting
# ==============================================================================
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS)
# In production: https://app.carepath.io
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Sliding Window Rate Limiting (Phase 10)
RATE_LIMITING_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=15
RATE_LIMIT_ML_PER_MIN=45
RATE_LIMIT_DEFAULT_PER_MIN=100

# ==============================================================================
# 7. Asynchronous Notifications & Email Configuration
# ==============================================================================
# Provider options: 'console', 'mock', or 'smtp'
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@carepath.io

# SMTP Configuration (when EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@carepath.io
# SMTP_PASSWORD=your_smtp_password

# Daily vitals reminder background job
NOTIFICATIONS_REMINDERS_ENABLED=true
