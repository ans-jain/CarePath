# ==============================================================================
# CarePath Frontend Environment Variables (.env.example)
#
# NOTE: All VITE_* variables are embedded into client-side JavaScript at build time.
# NEVER store secrets or sensitive credentials in frontend environment variables.
# ==============================================================================

# Backend REST API Base URL
# For local dev without reverse proxy: http://localhost:8080/api/v1
# For Docker Compose / Production with NGINX reverse proxy: /api/v1
VITE_BACKEND_URL=/api/v1

# ML Microservice Base URL
# For local dev without reverse proxy: http://localhost:8000
# For Docker Compose / Production with NGINX reverse proxy: ''
VITE_ML_URL=
